{
  "expo": {
    "name": "G One",
    "slug": "g-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "வானிலை தகவல் கிடைக்க உங்கள் இருப்பிடம் தேவை."
      }
    },
    "android": {
      "package": "com.gone.app",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0D0B14"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "வானிலை தகவல் கிடைக்க உங்கள் இருப்பிடம் தேவை."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A227",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "kalaiarasan.ganesapuram",
    "extra": {
      "eas": {
        "projectId": "88de07d1-70aa-425b-97d2-cdd43c332543"
      }
    }
  }
}
